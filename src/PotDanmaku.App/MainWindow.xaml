<Window x:Class="PotDanmaku.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PotDanmaku" Icon="{StaticResource AppIcon}" Width="740" Height="850" MinWidth="680" MinHeight="650"
 Background="#111827" Foreground="#E5E7EB" FontFamily="Microsoft YaHei UI" FontSize="14"
 WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="FileDrop" DragOver="FileDragOver">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Padding" Value="14,8"/><Setter Property="Background" Value="#E2E8F0"/><Setter Property="Foreground" Value="#111827"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="#1F2937"/><Setter Property="Foreground" Value="#F9FAFB"/><Setter Property="BorderBrush" Value="#475569"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E5E7EB"/><Setter Property="Margin" Value="0,8,0,4"/></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="#E5E7EB"/></Style>
  <Style TargetType="Slider"><Setter Property="SmallChange" Value="1"/><Setter Property="LargeChange" Value="5"/><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="TickFrequency" Value="1"/></Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <StackPanel Margin="28">
  <TextBlock Text="POTDANMAKU" Foreground="#5EEAD4" FontSize="12" FontWeight="Bold"/>
  <TextBlock Text="把弹幕带到你的播放器" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,7"/>
  <TextBlock Text="加载本地弹幕，随视频同步播放" Foreground="#94A3B8" Margin="0,0,0,22"/>
  <Border Background="#1F2937" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18">
   <StackPanel>
    <DockPanel><Button x:Name="OpenButton" Content="打开弹幕文件" DockPanel.Dock="Right" Click="OpenClick" Margin="14,0,0,0"/>
     <StackPanel><TextBlock x:Name="FileText" Text="拖入 XML / JSON / ASS 文件" FontWeight="SemiBold"/><TextBlock x:Name="ImportText" Text="尚未导入 · 预览可使用示例弹幕" Foreground="#94A3B8" FontSize="12" Margin="0,6,0,0"/></StackPanel>
    </DockPanel>
    <WrapPanel Margin="0,12,0,0"><Button Content="导入报告" Click="ReportClick" Padding="10,5"/><Button Content="取消导入" Click="CancelImportClick" Padding="10,5"/>
     <ComboBox x:Name="EncodingChoice" Width="165" SelectedIndex="0" VerticalContentAlignment="Center"><ComboBoxItem Content="自动 / UTF-8"/><ComboBoxItem Content="GB18030"/></ComboBox>
    </WrapPanel>
    <CheckBox x:Name="IncludeAss" Content="ASS：也导入无定位的普通字幕（默认关闭）" FontSize="12"/>
    <Button x:Name="AssStylesButton" Content="ASS 按样式筛选…" Click="AssStylesClick" IsEnabled="False" HorizontalAlignment="Left" Padding="10,5" Margin="0,6,0,0"/>
   </StackPanel>
  </Border>
  <DockPanel Margin="0,0,0,12"><Button Content="刷新播放器" DockPanel.Dock="Right" Click="RefreshClick" Margin="10,0,0,0"/><ComboBox x:Name="Players" MinHeight="36" VerticalContentAlignment="Center"/></DockPanel>
  <WrapPanel Margin="0,0,0,18"><Button Content="连接并播放弹幕" Click="ConnectClick" Background="#5EEAD4"/><Button Content="独立预览" Click="PreviewClick"/><Button Content="停止" Click="StopClick"/></WrapPanel>
  <CheckBox x:Name="AutoConnect" IsChecked="True" Content="自动连接唯一的 PotPlayer 窗口" Margin="0,0,0,8"/>
  <TextBlock x:Name="VideoText" Text="自动加载同目录同名弹幕；手动选择后记住视频关联、偏移和显示设置。" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,14"/>
  <WrapPanel Margin="0,0,0,16"><CheckBox x:Name="DanmakuEnabled" IsChecked="True" Content="显示弹幕" Click="VisibilityClick" Margin="0,6,20,0"/><Button Content="收起到托盘" Click="HideToTrayClick" Padding="12,5"/><TextBlock Text="双击托盘图标可打开设置；关闭窗口会退出。" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/></WrapPanel>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,20,10"><TextBlock Text="字号（1080 高度参考单位）"/><Slider x:Name="FontSizeControl" Minimum="8" Maximum="80" Value="16" Margin="0,10"/><TextBlock Text="{Binding ElementName=FontSizeControl,Path=Value,StringFormat={}{0:F0}}" Foreground="#5EEAD4"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="0,0,0,10"><TextBlock Text="横穿时长 · 越大越慢"/><Slider x:Name="DurationControl" Minimum="3" Maximum="40" Value="18" Margin="0,10"/><TextBlock Text="{Binding ElementName=DurationControl,Path=Value,StringFormat={}{0:F0} 秒}" Foreground="#5EEAD4"/></StackPanel>
   <StackPanel Grid.Row="1" Margin="0,0,20,10"><TextBlock Text="顶部显示区域"/><Slider x:Name="AreaControl" Minimum="10" Maximum="100" Value="25" Margin="0,10"/><TextBlock Text="{Binding ElementName=AreaControl,Path=Value,StringFormat={}{0:F0}%}" Foreground="#5EEAD4"/></StackPanel>
   <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"><TextBlock Text="透明度"/><Slider x:Name="OpacityControl" Minimum="10" Maximum="100" Value="100" Margin="0,10"/><TextBlock Text="{Binding ElementName=OpacityControl,Path=Value,StringFormat={}{0:F0}%}" Foreground="#5EEAD4"/></StackPanel>
  </Grid>
  <DockPanel Margin="0,5,0,12"><TextBlock Text="弹幕延后（秒）" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <TextBox x:Name="OffsetText" Width="85" Text="0.0" DockPanel.Dock="Left" ToolTip="正值延后，负值提前；输入后立即生效"/>
   <WrapPanel Margin="12,0,0,0"><Button Content="−0.1" Click="OffsetLessClick"/><Button Content="+0.1" Click="OffsetMoreClick"/><Button Content="重置偏移" Click="OffsetResetClick"/></WrapPanel>
  </DockPanel>
  <Expander Header="更多显示设置" Margin="0,0,0,10">
   <StackPanel Margin="0,10"><TextBlock Text="密度（轨道拥挤时会再减少显示数量）"/><Slider x:Name="DensityControl" Minimum="1" Maximum="100" Value="100"/><TextBlock Text="{Binding ElementName=DensityControl,Path=Value,StringFormat={}{0:F0}%}"/>
    <WrapPanel Margin="0,10,0,0"><TextBlock Text="最多行数" VerticalAlignment="Center"/><TextBox x:Name="RowsText" Text="13" Width="55" Margin="8,0,18,0"/><TextBlock Text="固定弹幕时长（秒）" VerticalAlignment="Center"/><TextBox x:Name="FixedText" Text="5" Width="55" Margin="8,0"/><TextBlock Text="描边" VerticalAlignment="Center"/><TextBox x:Name="StrokeText" Text="0.6" Width="55" Margin="8,0"/></WrapPanel>
    <CheckBox x:Name="PreserveColor" IsChecked="True" Content="保留弹幕颜色"/><TextBlock Text="顶部、底部固定弹幕都排在所选显示区域内。" FontSize="12" Foreground="#94A3B8"/>
    <WrapPanel Margin="0,12,0,0"><TextBlock Text="弹幕刷新" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="FrameLimitChoice" Width="170" SelectedIndex="0"><ComboBoxItem Content="跟随显示器（推荐）"/><ComboBoxItem Content="上限 60 FPS"/><ComboBoxItem Content="上限 120 FPS"/></ComboBox></WrapPanel>
    <WrapPanel Margin="0,12,0,0"><TextBlock Text="播放倍速" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="RateChoice" Width="170" SelectedIndex="0"><ComboBoxItem Content="自动读取（含 3×）"/><ComboBoxItem Content="手动 0.5×"/><ComboBoxItem Content="手动 1×"/><ComboBoxItem Content="手动 1.5×"/><ComboBoxItem Content="手动 2×"/><ComboBoxItem Content="手动 3×"/></ComboBox></WrapPanel>
    <TextBlock Text="通常保持自动读取。仅在播放器无法返回倍速时选手动，并保持与播放器一致。弹幕时长按视频时间计算。" FontSize="12" Foreground="#94A3B8" Margin="0,8,0,0"/>
    <Button Content="恢复顶部 1/4 慢速预设" Click="PresetClick" HorizontalAlignment="Left" Margin="0,10,0,0"/>
   </StackPanel>
  </Expander>
  <Expander Header="覆盖区域校准（客户区边距百分比）" Margin="0,0,0,10">
   <Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,10,0"><TextBlock Text="左"/><Slider x:Name="LeftMargin" Minimum="0" Maximum="40" IsSnapToTickEnabled="False" SmallChange="0.1"/><TextBlock Text="{Binding ElementName=LeftMargin,Path=Value,StringFormat={}{0:F1}%}"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="上"/><Slider x:Name="TopMargin" Minimum="0" Maximum="40" IsSnapToTickEnabled="False" SmallChange="0.1"/><TextBlock Text="{Binding ElementName=TopMargin,Path=Value,StringFormat={}{0:F1}%}"/></StackPanel>
    <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="右（播放列表）"/><Slider x:Name="RightMargin" Minimum="0" Maximum="40" IsSnapToTickEnabled="False" SmallChange="0.1"/><TextBlock Text="{Binding ElementName=RightMargin,Path=Value,StringFormat={}{0:F1}%}"/></StackPanel>
    <StackPanel Grid.Column="3"><TextBlock Text="下（控制栏）"/><Slider x:Name="BottomMargin" Minimum="0" Maximum="40" IsSnapToTickEnabled="False" SmallChange="0.1"/><TextBlock Text="{Binding ElementName=BottomMargin,Path=Value,StringFormat={}{0:F1}%}"/></StackPanel>
   </Grid>
  </Expander>
  <Border Background="#1F2937" CornerRadius="8" Padding="14" Margin="0,5,0,14"><StackPanel>
   <TextBlock x:Name="StatusText" Text="准备就绪。先导入弹幕，再连接 PotPlayer。"/>
   <TextBlock x:Name="LayoutText" Foreground="#5EEAD4" FontSize="12" Margin="0,8,0,0"/>
  </StackPanel></Border>
  <Expander Header="诊断与统计"><StackPanel Margin="0,10"><TextBlock x:Name="MetricsText" Foreground="#94A3B8" FontSize="12"/><WrapPanel Margin="0,10,0,0"><Button Content="导出诊断" Click="ExportClick"/><Button Content="重建绘制层" Click="RebuildClick"/><Button Content="使用说明" Click="ReadmeClick"/></WrapPanel></StackPanel></Expander>
  <TextBlock Text="区域为估算，可手动校准。请在 PotPlayer 中保留对白字幕，并关闭同一份弹幕 ASS，避免重复显示。" Foreground="#94A3B8" FontSize="12" Margin="0,18,0,0"/>
 </StackPanel></ScrollViewer>
</Window>
